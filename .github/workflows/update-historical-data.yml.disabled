name: Update Historical Database
on:
  schedule:
    - cron: '0 6 * * *'  # Daily at 6 AM
  workflow_dispatch:

jobs:
  update-data:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'

      - name: Generate Historical Database
        run: node tools/generate-historical-database.js

      - name: Verify Historical Database
        run: node tools/verify-historical-data.js

      - name: Commit and Push Changes
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add data/historical-database.json data/historical-database.backup.json
          git commit -m "chore: update historical database [skip ci]" || echo "No changes to commit"
          git push
